+/// Connect an ID/relay endpoint through the Windows system-certificate mTLS
+/// transport. This is intentionally separate from `connect_tcp` so direct
+/// peers, proxies, WebSocket, and WebRTC retain their upstream semantics.
+#[cfg(target_os = "windows")]
+pub async fn connect_tcp_mtls_service(
+    target: String,
+    ms_timeout: u64,
+) -> ResultType<Stream> {
+    Ok(Stream::Tcp(
+        crate::mtls_windows::connect_service(target, ms_timeout).await?,
+    ))
+}
